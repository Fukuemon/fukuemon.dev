{
  "name": "fukuemon-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @fukuemon/web dev",
    "build": "pnpm -r --sequential run build",
    "preview": "pnpm --filter @fukuemon/web preview",
    "lint": "oxlint --type-aware",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm -r --sequential run typecheck",
    "test": "pnpm -r --sequential run test:cov",
    "knip": "knip",
    "doctor": "npx --yes react-doctor@latest --verbose --scope changed",
    "check:contrast": "pnpm --filter @fukuemon/design-system run check",
    "check:worker-name": "bash scripts/check-worker-name.sh",
    "check:deploy": "pnpm --filter @fukuemon/web exec wrangler deploy --dry-run",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm run check:contrast && pnpm run check:worker-name && pnpm run test && pnpm run build && pnpm run check:deploy",
    "infra:init": "terraform -chdir=infra/cloudflare init",
    "infra:plan": "terraform -chdir=infra/cloudflare plan",
    "infra:apply": "terraform -chdir=infra/cloudflare apply",
    "infra:check": "bash scripts/check-infra.sh",
    "infra:bootstrap:init": "terraform -chdir=infra/bootstrap init",
    "infra:bootstrap:apply": "terraform -chdir=infra/bootstrap apply"
  },
  "devDependencies": {
    "knip": "^6.32.2",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.27.0",
  "knip": {
    "workspaces": {
      "apps/web": {
        "entry": [
          "src/features/lab/panel/SqlRunner.tsx"
        ]
      }
    },
    "ignoreBinaries": [
      "terraform"
    ],
    "ignoreUnresolved": [
      "/pagefind/pagefind.js"
    ]
  }
}
