{
  "name": "fukuemon-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm --filter @fukuemon/web dev",
    "build": "pnpm -r --sequential run build",
    "preview": "pnpm --filter @fukuemon/web exec astro preview --port 4321",
    "lint": "oxlint --type-aware",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm -r --sequential run typecheck",
    "test": "pnpm -r --sequential run test:cov",
    "test:ui": "pnpm --filter @fukuemon/ui test",
    "knip": "knip",
    "doctor": "npx --yes react-doctor@latest --verbose --scope changed",
    "check:doctor": "npx --yes react-doctor@0.9.17 -y --no-score --no-supply-chain --scope changed",
    "check:similarity": "similarity-ts --fail-on-duplicates apps packages",
    "check:contrast": "bash scripts/check-contrast-themes.sh",
    "check:raw-values": "node scripts/check-raw-values.mjs",
    "check:utilities": "node scripts/check-utilities.mjs --doc packages/ui/DESIGN.md",
    "build:tokens": "node scripts/build-static-tokens.mjs --out ./packages/ui/src/tokens/tokens.gen.css ./packages/ui/src/tokens/primitive.css ./packages/ui/src/tokens/semantic.css ./packages/ui/src/tokens/semantic-dark.css && node scripts/build-code-theme.mjs",
    "check:tokens": "node scripts/build-static-tokens.mjs --check --out ./packages/ui/src/tokens/tokens.gen.css ./packages/ui/src/tokens/primitive.css ./packages/ui/src/tokens/semantic.css ./packages/ui/src/tokens/semantic-dark.css && node scripts/build-code-theme.mjs --check",
    "build:art": "node scripts/build-art.mjs",
    "check:art": "node scripts/build-art.mjs --check",
    "check:worker-name": "bash scripts/check-worker-name.sh",
    "check:deploy": "pnpm --filter @fukuemon/web exec wrangler deploy --dry-run && pnpm --filter @fukuemon/ui exec wrangler deploy --dry-run && pnpm --filter @fukuemon/playground exec wrangler deploy --dry-run",
    "build:storybook": "pnpm --filter @fukuemon/ui build-storybook",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm run check:doctor && pnpm run check:similarity && pnpm run check:contrast && pnpm run check:raw-values && pnpm run check:utilities && pnpm run check:tokens && pnpm run check:art && pnpm run check:worker-name && pnpm run test && pnpm run test:ui && pnpm run build && pnpm run check:garden-bundle && pnpm run test:visual && pnpm run build:storybook && pnpm run check:deploy",
    "infra:init": "terraform -chdir=infra/cloudflare init",
    "infra:plan": "terraform -chdir=infra/cloudflare plan",
    "infra:apply": "terraform -chdir=infra/cloudflare apply",
    "infra:check": "bash scripts/check-infra.sh",
    "infra:bootstrap:init": "terraform -chdir=infra/bootstrap init",
    "infra:bootstrap:apply": "terraform -chdir=infra/bootstrap apply",
    "test:visual": "pnpm --filter @fukuemon/web run test:visual",
    "check:garden-bundle": "node scripts/check-garden-bundle.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "knip": "^6.32.2",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "1.64.1",
    "tailwindcss": "^4.3.3",
    "textlint": "^15.8.0",
    "textlint-rule-no-mix-dearu-desumasu": "^6.0.4",
    "textlint-rule-preset-ai-words-ja": "^1.2.1",
    "textlint-rule-prh": "^6.1.0",
    "textlint-rule-sentence-length": "^5.2.1",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.27.0",
  "knip": {
    "ignore": [
      "docs/design/prototypes/**"
    ],
    "workspaces": {
      ".": {
        "entry": [
          "scripts/check-contrast.mjs"
        ]
      },
      "apps/playground": {
        "entry": [
          "src/*/main.tsx"
        ]
      },
      "packages/ui": {
        "entry": [
          "src/tokens/tokens.gen.css",
          "e2e/**/*.ts"
        ]
      }
    },
    "ignoreBinaries": [
      "terraform",
      "similarity-ts",
      "go"
    ],
    "ignoreDependencies": [
      "playwright",
      "textlint-rule-no-mix-dearu-desumasu",
      "textlint-rule-preset-ai-words-ja",
      "textlint-rule-prh",
      "textlint-rule-sentence-length"
    ]
  }
}
