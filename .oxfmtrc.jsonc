{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // apm が配置し、書き換えるファイル。整形すると次の apm install で差分が出る
  "ignorePatterns": [
    ".agents/",
    ".claude/",
    ".codex/",
    "apm.lock.yaml",
    // スクリプトが書き出す生成物。整形すると生成の --check が食い違う
    "packages/ui/src/tokens/*.gen.*",
    // 試作のソース。build-i.mjs が shared.css を文字列の位置で切るので、整形すると違う HTML を書く
    "docs/design/prototypes/",
    // Go の lib/wasm/wasm_exec.js の写し。Go のものと同じかを、ビルドのスクリプトが比べる
    "packages/go-runtime/src/worker/vendor/wasm_exec.js",
  ],
}
