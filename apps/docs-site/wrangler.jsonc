{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fukuemon-dev-docs",
  "compatibility_date": "2026-08-30",
  // ハンドラを持たないため main を置かない (ADR-0005)
  "assets": {
    "directory": "./dist",
  },
  // 公開先は Terraform の custom domain の docs.<zone> だけにする。workers_dev の既定は true で、
  // 書かないと apply の前から *.workers.dev で文書のサイトが開ける (ADR-0032)
  "workers_dev": false,
  "preview_urls": false,
}
