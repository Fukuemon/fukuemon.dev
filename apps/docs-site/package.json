{
  "name": "@fukuemon/docs-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "uv run --frozen zensical build --clean -f ../../zensical.toml && cp public/_headers dist/_headers",
    "dev": "uv run --frozen zensical serve -f ../../zensical.toml",
    "deploy": "wrangler deploy",
    "check:closed-urls": "bash scripts/check-closed-urls.sh"
  },
  "devDependencies": {
    "wrangler": "^4.127.1"
  }
}
