---
import SiteLayout from "./SiteLayout.astro";
import KindTabs from "../components/KindTabs.astro";
import SiteSearch from "../components/SiteSearch.astro";
import ContentTable from "../components/ContentTable.astro";
import { listContent } from "../lib/content";
import { ALL_KIND, KIND_LABEL } from "../lib/format";
import type { ContentRef, ContentType } from "@fukuemon/content-model";

interface Props {
  current: "all" | ContentType;
  items: ContentRef[];
  showKind: boolean;
  lead: string;
}
const { current, items, showKind, lead } = Astro.props;

const counts = {
  all: (await listContent()).length,
  article: (await listContent({ type: "article" })).length,
  "hands-on": (await listContent({ type: "hands-on" })).length,
};

const title = current === "all" ? ALL_KIND.title : KIND_LABEL[current];
---

<SiteLayout title={`${title} — fukuemon.dev`} description={lead} current="posts">
  <div class="page">
    <div class="section-lead">
      <p class="prose">{lead}</p>
      <SiteSearch />
    </div>

    <KindTabs current={current} counts={counts} />
    <ContentTable items={items} showKind={showKind} />
  </div>

  <div class="tail"></div>
</SiteLayout>
