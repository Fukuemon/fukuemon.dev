---
import MetaLine from "../components/MetaLine.astro";
import RelatedList from "../components/RelatedList.astro";
import { getRelated } from "../lib/content";
import { KIND_INDEX, KIND_LABEL } from "../lib/format";
import type { ContentRef } from "@fukuemon/content-model";

interface Props {
  ref: ContentRef;
  /** 記事は 42rem、ハンズオンは縦罫の分だけ広い */
  class?: string;
}
const { ref, class: extra } = Astro.props;
const related = await getRelated(ref.contentId);
---

<article class:list={["marks", "prose", "doc-body", extra ?? "w-full"]} data-pagefind-body>
  <p class="mono meta flex gap-intra-2 items-baseline">
    <a href={KIND_INDEX[ref.type]}>{KIND_LABEL[ref.type]}</a>
    <span aria-hidden="true">/</span>
    <span>{ref.tags[0]}</span>
  </p>
  <h1 class="display my-intra-3">{ref.title}</h1>
  <MetaLine ref={ref} />
  <slot />
  <RelatedList items={related} />
</article>
