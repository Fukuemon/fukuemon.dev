---
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  /** 検索エンジンに載せないページ。canonical を出さず、noindex を出す */
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="min-h-dvh bg-surface font-sans text-body text-text">
    <a
      class="sr-only border border-border-field bg-surface-raised text-label text-link underline underline-offset-4 focus:not-sr-only focus:absolute focus:start-2 focus:top-2 focus:px-4 focus:py-4 focus-visible:focus-ring"
      href="#main">本文へスキップ</a
    >
    <SiteHeader />
    <main id="main"><slot /></main>
  </body>
</html>
