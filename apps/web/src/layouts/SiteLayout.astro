---
import InkBackground from "../components/ink-background/InkBackground.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { settingsScript } from "../components/site-settings/settings";
import { DEFAULT_OG_IMAGE } from "../features/og-image/og-image";
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  /** 検索エンジンに載せないページ。canonical を出さず、noindex を出す */
  noindex?: boolean;
  /** 画面全体に薄墨の背景の絵を敷くページ（ADR-0082）。トップでは、庭を出さないときだけ出る */
  inkBackground?: boolean;
  /** OGP の画像のパス。省くと、トップと一覧のページの共通の画像になる */
  ogImage?: string;
  /** 記事のページは article、ほかは website */
  ogType?: "website" | "article";
}
const {
  title,
  description,
  noindex = false,
  inkBackground = false,
  ogImage = DEFAULT_OG_IMAGE,
  ogType = "website",
} = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ja" data-ink-background={inkBackground ? "" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:type" content={ogType} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="fukuemon.dev" href="/rss.xml" />
    <script is:inline set:html={settingsScript()} />
    <slot name="head" />
  </head>
  <body class="min-h-dvh bg-surface font-sans text-body text-text">
    {inkBackground && <InkBackground />}
    <SiteHeader />
    <main id="main"><slot /></main>
    <slot name="footer" />
  </body>
</html>

<style is:global>
  /* 背景の絵を body の背景に隠させず本文の後ろに出すため、ページの背景の色を html に移す */
  html[data-ink-background]:not(.stage-on) {
    background: var(--fd-color-surface);
  }

  html[data-ink-background]:not(.stage-on) body {
    background: transparent;
  }

  /* 絵がロゴと下の罫に重ならないよう、ヘッダーに紙の色を敷き、絵を罫で切る。ヘッダーが折り返して高くなっても、ヘッダーの高さのまま隠れる */
  html[data-ink-background]:not(.stage-on) [data-site-header] {
    background: var(--fd-color-surface);
  }
</style>
