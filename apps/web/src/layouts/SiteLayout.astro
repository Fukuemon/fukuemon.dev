---
import SiteHeader from "../components/SiteHeader.astro";
import SiteSettingsPopover from "../components/site-settings/SiteSettingsPopover.astro";
import { settingsScript } from "../components/site-settings/settings";
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  /** 検索エンジンに載せないページ。canonical を出さず、noindex を出す */
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="fukuemon.dev" href="/rss.xml" />
    <script is:inline set:html={settingsScript()} />
    <slot name="head" />
  </head>
  <body class="min-h-dvh bg-surface font-sans text-body text-text">
    <SiteHeader />
    <SiteSettingsPopover />
    <main id="main"><slot /></main>
  </body>
</html>
