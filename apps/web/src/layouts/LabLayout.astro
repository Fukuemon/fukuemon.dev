---
import SiteLayout from "./SiteLayout.astro";
import StepList from "../features/lab/steps/StepList.astro";
import Side from "../features/doc/Side.astro";
import DbPeek from "../features/lab/catalog/DbPeek";
import LocalSetup from "../features/lab/local/LocalSetup.astro";
import MetaLine from "../features/listing/MetaLine.astro";
import RelatedList from "../features/listing/RelatedList.astro";
import { getRelated } from "../lib/content";
import { KIND_INDEX, KIND_LABEL } from "../lib/format";
import type { ContentRef, Step } from "@fukuemon/content-model";

interface Props {
  ref: ContentRef;
  steps: Step[];
  /** 最初の `h2` より前に本文があるか。「はじめに」の面を出すかを決める */
  intro: boolean;
  /** 実行環境を持つときだけ true。DB の一覧を側柱に出す */
  live: boolean;
  /** 手元で用意する種類のときだけ渡す */
  local?: {
    repository: string;
    via: "devcontainer" | "docker-compose" | "manual";
    requires: { name: string; check?: string }[];
  };
}
const { ref, steps, intro, live, local } = Astro.props;
const related = await getRelated(ref.contentId);
---

{/* 全手順を 1 文書に入れて CSS で 1 枚だけ出す。
    別 URL に割ると手順ごとに実行環境を作り直すことになる */}
<SiteLayout title={`${ref.title} — fukuemon.dev`} description={ref.description}>
  <div class="g-doc" data-lab data-content-id={ref.contentId} data-open="true">
    <Side id="lab" label="手順">
      <StepList steps={steps} intro={intro} />
      {live && <DbPeek client:idle contentId={ref.contentId} />}
    </Side>

    <div class="labmain">
      <header class="labhead">
        <p class="mono meta flex gap-intra-2 items-baseline">
          <a href={KIND_INDEX[ref.type]}>{KIND_LABEL[ref.type]}</a>
          <span aria-hidden="true">/</span>
          <span>{ref.tags[0]}</span>
        </p>
        <h1 class="display labhead__title">{ref.title}</h1>
        <MetaLine ref={ref} />
      </header>

      <article class="prose lab-body w-full" data-pagefind-body>
        {
          /* 手順ごとに繰り返す情報ではないので「はじめに」の面に置く */
          local && (
            <div class="step" id="step--1" data-step="-1" data-title="はじめに">
              <LocalSetup {...local} />
            </div>
          )
        }
        <slot />
      </article>

      {/* 狭い画面の下余白は、左下に固定した開閉ボタンと前後ボタンの重なりを避けるため */}
      <nav
        class="flex items-center justify-between gap-intra-3 mt-inter-2 pt-intra-3 border-t border-rule-strong max-wide:pb-[calc(var(--gutter)+3rem)]"
        aria-label="手順の移動"
      >
        <button
          type="button"
          class="btn aria-disabled:opacity-35 aria-disabled:cursor-default"
          data-go="prev"
          aria-disabled="true"
        >
          ← 前へ
        </button>
        <span class="mono meta labnav__now flex-auto text-center"></span>
        <button
          type="button"
          class="btn aria-disabled:opacity-35 aria-disabled:cursor-default"
          data-go="next"
          aria-disabled="true"
        >
          次へ →
        </button>
      </nav>

      <footer class="labfoot">
        <RelatedList items={related} />
            </footer>
    </div>
  </div>
</SiteLayout>

<script>
  import { mountSteps } from "../features/lab/steps/controller";
  const root = document.querySelector<HTMLElement>("[data-lab]");
  if (root) mountSteps(root);
</script>
