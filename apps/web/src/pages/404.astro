---
import { Link } from "@fukuemon/ui";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="ページが見つかりません | fukuemon.dev" description="お探しのページは見つかりませんでした。" noindex>
  <div class="px-4 py-8 md:px-6">
    <div class="mx-auto max-w-page">
      <h1 class="font-heading text-heading-lg font-semibold">ページが見つかりません</h1>
      <p class="mt-4 text-body">お探しのページは、移動したか削除されました。</p>
      <ul class="mt-4 flex flex-col gap-2 text-body">
        <li><Link href="/articles" isStandalone>記事の一覧へ</Link></li>
        <li><Link href="/" isStandalone>トップへ戻る</Link></li>
      </ul>
    </div>
  </div>
</SiteLayout>
