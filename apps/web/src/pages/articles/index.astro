---
import ArticleRow from "../../features/articles/ArticleRow.astro";
import InkVeil from "../../components/ink-background/InkVeil.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getArticleList } from "../../lib/content/articles";

const items = await getArticleList();
---

<SiteLayout title="記事 | fukuemon.dev" description="fukuemon.dev で公開した記事の一覧です。" inkBackground>
  <InkVeil class="px-4 py-8 md:px-6">
    <div class="mx-auto flex max-w-page flex-col gap-4">
      <h1 class="font-heading text-heading-lg font-semibold">記事</h1>
      {
        items.length === 0 ? (
          <p class="text-body">記事は準備中です。公開したら、ここに並べます。</p>
        ) : (
          <ul class="flex flex-col border-t border-border">
            {items.map(({ ref, series }) => (
              <ArticleRow article={ref} series={series} />
            ))}
          </ul>
        )
      }
    </div>
  </InkVeil>
</SiteLayout>
