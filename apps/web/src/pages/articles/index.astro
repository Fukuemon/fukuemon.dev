---
import { ArtBand } from "@fukuemon/ui";
import ArticleRow from "../../features/articles/ArticleRow.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getArticleList } from "../../lib/content/articles";

const items = await getArticleList();
---

<SiteLayout title="記事 | fukuemon.dev" description="fukuemon.dev で公開した記事の一覧です。">
  <div class="px-4 py-8 md:px-6">
    <div class="mx-auto flex max-w-page flex-col gap-4">
      <h1 class="font-heading text-heading-lg font-semibold">記事</h1>
      <ArtBand layout="band" motif="seigaiha" />
      {
        items.length === 0 ? (
          <p class="text-body">公開した記事は、まだありません。</p>
        ) : (
          <ul class="flex flex-col">
            {items.map(({ ref, series }) => (
              <ArticleRow article={ref} series={series} />
            ))}
          </ul>
        )
      }
    </div>
  </div>
</SiteLayout>
