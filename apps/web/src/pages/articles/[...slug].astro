---
import { SeriesPager } from "@fukuemon/ui";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getArticlePaths, renderArticle, type ArticlePageProps } from "../../lib/content/articles";

export const getStaticPaths = getArticlePaths;

type Props = ArticlePageProps;
const { entry, series } = Astro.props;
const { title, description, publishedAt, updatedAt } = entry.data;
const Content = await renderArticle(entry);

const toDate = (d: Date) => d.toISOString().slice(0, 10);
---

<SiteLayout title={`${title} | fukuemon.dev`} description={description}>
  <div class="px-4 py-8 md:px-6">
    <article class="mx-auto flex max-w-prose flex-col gap-8">
      <header class="flex flex-col gap-2">
        <h1 class="font-heading text-heading-lg font-semibold">{title}</h1>
        <p class="text-caption text-text-secondary">
          <time datetime={toDate(publishedAt)}>{toDate(publishedAt)}</time>
          {
            updatedAt && (
              <>
                {" "}（更新 <time datetime={toDate(updatedAt)}>{toDate(updatedAt)}</time>）
              </>
            )
          }
        </p>
      </header>
      <div class="prose">
        <Content />
      </div>
      {
        series && (
          <SeriesPager
            series={series.title}
            position={series.position}
            total={series.total}
            prev={series.prev}
            next={series.next}
          />
        )
      }
    </article>
  </div>
</SiteLayout>
