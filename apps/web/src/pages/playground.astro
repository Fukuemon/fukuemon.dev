---
import SiteLayout from "../layouts/SiteLayout.astro";
import Playground from "../components/lab/Playground";

const setup = `create table events (
  id bigserial primary key,
  kind text not null,
  at timestamptz not null default now()
);
insert into events (kind, at)
select case when g % 3 = 0 then 'click' else 'view' end,
       now() - (g || ' seconds')::interval
from generate_series(1, 50000) g;
analyze events;`;

const presets = [
  {
    label: "版と実行環境",
    sql: "select version();",
  },
  {
    label: "実行計画を見る",
    sql: "explain analyze\nselect kind, count(*) from events group by kind;",
  },
  {
    label: "インデックスの効き方",
    sql: "create index if not exists events_kind_idx on events (kind);\nanalyze events;\n\nexplain analyze\nselect * from events where kind = 'click';",
  },
  {
    label: "統計情報を見る",
    sql: "select attname, n_distinct, most_common_vals\nfrom pg_stats where tablename = 'events';",
  },
  {
    label: "設定を覗く",
    sql: "select name, setting, unit\nfrom pg_settings\nwhere name in ('shared_buffers', 'work_mem', 'random_page_cost');",
  },
];
---

<SiteLayout
  title="playground — fukuemon.dev"
  description="ブラウザの中の Postgres に、好きな SQL を投げられます。"
  current="playground"
>
  <div class="page">
    <section class="section-lead">
      <p class="prose">
        ブラウザの中だけで動く Postgres です。サーバーへは何も送りません。手順に縛られず、好きな SQL を投げられます。
      </p>
    </section>

    <Playground client:visible setup={setup} presets={presets} engine="Postgres" />
  </div>
  <div class="tail"></div>
</SiteLayout>
