---
import LabLayout from "../../layouts/LabLayout.astro";
import { getContent, isPublic, listLabEntries, renderEntry } from "../../lib/content";
import type { Step } from "@fukuemon/content-model";
import type { BootSpec } from "../../features/lab/steps/bootSpec";

export async function getStaticPaths() {
  const entries = await listLabEntries(isPublic);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, remarkPluginFrontmatter } = await renderEntry(entry);
const steps = (remarkPluginFrontmatter.labSteps ?? []) as Step[];
const boot = remarkPluginFrontmatter.labBoot as BootSpec | undefined;

const ref = await getContent(entry.data.contentId);
if (!ref) throw new Error(`ContentRef が見つかりません: ${entry.data.contentId}`);

const it = entry.data.interactive;
const local =
  it?.level === "local"
    ? { repository: it.repository, via: it.via, requires: it.requires }
    : undefined;

const intro = remarkPluginFrontmatter.labHasIntro === true || local !== undefined;
const live = it?.level === "embedded";
---

<LabLayout ref={ref} steps={steps} intro={intro} live={live} local={local} boot={boot}>
  <Content />
</LabLayout>
