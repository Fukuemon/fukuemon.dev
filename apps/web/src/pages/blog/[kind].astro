---
import PostsLayout from "../../layouts/PostsLayout.astro";
import { listContent } from "../../lib/content";
import { CONTENT_TYPES, kindSlug } from "../../lib/format";

export async function getStaticPaths() {
  return CONTENT_TYPES.map((type) => ({ params: { kind: kindSlug(type) }, props: { type } }));
}

const { type } = Astro.props;
const items = await listContent({ type });
const lead =
  type === "hands-on"
    ? "手順に沿って、コードを動かしながら進めるハンズオンの一覧です。"
    : "調べて確かめたことを書いた技術記事の一覧です。";
---

<PostsLayout current={type} items={items} showKind={false} lead={lead} />
