---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Playground from "../../components/lab/Playground";
import DbPeek from "../../components/lab/DbPeek";
import Presets from "../../components/lab/Presets";
import Side from "../../components/Side.astro";
import { listPlaygrounds, renderPlayground } from "../../lib/content";

export async function getStaticPaths() {
  const items = await listPlaygrounds();
  return items.map((entry) => ({ params: { slug: entry.data.contentId }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await renderPlayground(entry);
const d = entry.data;
---

<SiteLayout title={`${d.title} — playground`} description={d.description}>
  <div class="g-doc" data-side-root data-open="true">
    <Side id="pg" label="試す">
      <Presets client:idle contentId="playground" presets={d.presets} />
      <DbPeek client:idle contentId="playground" />
    </Side>
    <div class="labmain labmain--wide">
      <header class="labhead">
        <p class="mono meta flex gap-intra-2 items-baseline">
          <a href="/playground">playground</a>
          <span aria-hidden="true">/</span>
          <span>{d.runtime}</span>
        </p>
        <h1 class="display labhead__title">{d.title}</h1>
      </header>
      <div class="prose pg-intro"><Content /></div>
      <Playground client:load setup={d.setup} initial={d.presets[0]?.sql ?? "select version();"} engine="Postgres" />
    </div>
  </div>
  <div class="h-inter-3"></div>
</SiteLayout>

<script>
  import { mountSide } from "../../components/side";
  const root = document.querySelector<HTMLElement>("[data-side-root]");
  if (root) mountSide(root);
</script>
