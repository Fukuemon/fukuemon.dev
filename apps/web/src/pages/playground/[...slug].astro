---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Playground from "../../features/lab/panel/Playground";
import DbPeek from "../../features/lab/catalog/DbPeek";
import Presets from "../../features/lab/panel/Presets";
import Side from "../../components/Side.astro";
import { groupOf, listPlaygrounds, renderPlayground } from "../../lib/content";

export async function getStaticPaths() {
  const items = await listPlaygrounds();
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await renderPlayground(entry);
const d = entry.data;
const group = groupOf(entry);
---

<SiteLayout title={`${d.title} — Playground`} description={d.description}>
  <div class="g-doc" data-side-root>
    <Side id="pg" label="試す">
      <Presets client:idle contentId="playground" presets={d.presets} />
      <DbPeek client:idle contentId="playground" />
    </Side>
    <div class="labmain labmain--wide">
      <header class="labhead">
        <p class="mono meta flex gap-intra-2 items-baseline">
          <a class="hit-up" href="/playground">Playground</a>
          <span aria-hidden="true">/</span>
          <a class="hit-up" href={`/playground#${group}`}>{group}</a>
        </p>
        <h1 class="display labhead__title">{d.title}</h1>
      </header>
      <div class="prose my-intra-3"><Content /></div>
      <Playground client:load setup={d.setup} initial={d.presets[0]?.sql ?? "select version();"} engine="Postgres" />
    </div>
  </div>
  <div class="h-inter-3"></div>
</SiteLayout>

<script>
  import { mountSide, shutIfNarrow } from "../../components/side";
  import { onPreset } from "../../features/lab/bus";
  const root = document.querySelector<HTMLElement>("[data-side-root]");
  if (root) {
    mountSide(root);
    // 狭い画面では面が入力欄を覆う。選んだ SQL が欄に入ったことを見せる
    onPreset("playground", () => shutIfNarrow(root));
  }
</script>
