---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Tate from "../../components/Tate.astro";
import { listPlaygrounds } from "../../lib/content";

const items = await listPlaygrounds();
---

<SiteLayout title="playground — fukuemon.dev" description="ブラウザ上でコードを実際に動かせる環境。">
  <section class="g-rail mt-inter-3 mx-(--gutter)">
    <Tate as="h2" class="tate-head" text="遊び場" />
    <div class="flex justify-end items-baseline pb-intra-1">
      <span class="mono meta">{items.length} 本</span>
    </div>
    <div>
      <p class="prose mt-intra-2 mb-0 max-w-(--measure-w) text-fg-2">
        ブラウザ上でコードを実際に動かせる環境<br />
        Try X in Y minutesに影響を受けてます
      </p>
      <div class="mt-inter-1 grid grid-cols-[repeat(auto-fit,minmax(min(18rem,100%),22rem))] max-narrow:grid-cols-[minmax(0,1fr)]">
        {
          items.map((p) => (
            <a class="flex flex-col px-intra-4 first:ps-0 max-narrow:px-0 text-fg border-rule not-first:border-s max-narrow:not-first:border-s-0 max-narrow:not-first:border-t max-narrow:not-first:pt-intra-3 max-narrow:not-first:mt-intra-3" href={`/playground/${p.data.contentId}`}>
              <span aria-hidden="true" class="w-[26px] h-[2px] bg-now" />
              <h3 class="mt-intra-2 text-[1.05rem]">{p.data.title}</h3>
              <p class="prose mt-intra-1 mb-intra-3 text-[0.9rem] text-fg-2 grow">{p.data.description}</p>
              <span class="mono meta text-fg-2">{p.data.runtime}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <div class="h-inter-3"></div>
</SiteLayout>
