---
import { Link } from "@fukuemon/ui";
import InkBackground from "../../features/top-garden/ink/InkBackground.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { PLAYGROUND_ORIGIN } from "../../lib/playground/origin";

// project を付けずに開くと、各ツールはデフォルトのプロジェクトで開く（ADR-0049）
const tools = [
  { name: "Node", path: "/node/" },
  { name: "SQL", path: "/sql/" },
  { name: "Go", path: "/go/" },
];
---

<SiteLayout title="プレイグラウンド | fukuemon.dev" description="Node、SQL、Go の実行環境の一覧です。">
  <InkBackground />
  <div class="px-4 py-8 md:px-6">
    <div class="mx-auto flex max-w-page flex-col gap-4">
      <h1 class="font-heading text-heading-lg font-semibold">プレイグラウンド</h1>
      <ul class="flex flex-col border-t border-border">
        {
          tools.map((tool) => (
            <li class="border-b border-border py-2">
              <Link
                href={`${PLAYGROUND_ORIGIN}${tool.path}`}
                isStandalone
                isLargeTarget
                data-testid="playground-tool-link"
              >
                {tool.name}
              </Link>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</SiteLayout>
