---
// 庭を描く canvas と、庭の中のボタンを置く。html に class stage-on が付いたときだけ、画面の全体に出す。
// 和紙に置いたセクションは、場面のバンドルがこの中へ移すので、外側の要素は読み上げから隠さない。
import { STATIONS } from "../layout";
---

<div class="garden-stage bg-surface" data-garden-stage>
  <canvas aria-hidden="true"></canvas>
</div>
<nav class="garden-nav" data-garden-nav aria-label="庭の中の移動">
  <div class="stops">
    {
      STATIONS.map(({ label }, i) => (
        <button type="button" class="focus-visible:focus-ring" data-station={i} aria-current={i === 0 ? "true" : "false"}>
          {label}
        </button>
      ))
    }
  </div>
  <div class="tools">
    <button type="button" class="focus-visible:focus-ring" data-garden-pause aria-pressed="false">動きを止める</button>
    <button type="button" class="focus-visible:focus-ring" data-garden-plain>文だけで読む</button>
  </div>
</nav>
<p class="sr-only" data-garden-live aria-live="polite"></p>

<style>
  .garden-stage,
  .garden-nav {
    display: none;
  }

  :global(html.stage-on) {
    overflow: hidden;
  }

  :global(html.stage-on) .garden-stage {
    position: fixed;
    inset: 0;
    z-index: 20;
    display: block;
  }

  canvas {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  .garden-stage :global(.garden-cards) {
    position: absolute;
    inset: 0;
  }

  /* 見せていない和紙の文は、クリックを受けない。CSS3DRenderer が要素に pointer-events: auto を書くので、!important で止める */
  .garden-stage :global([data-garden-card]:not(.is-current)) {
    pointer-events: none !important;
  }

  /* 庭の中のボタン（top-garden の Design Doc の「庭の中のボタンの並び」） */
  :global(html.stage-on.garden-ready) .garden-nav {
    position: fixed;
    inset: auto 1.25rem 1.25rem;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .garden-nav > * {
    pointer-events: auto;
  }

  .stops {
    display: flex;
  }

  .tools {
    position: absolute;
    inset-inline-end: 0;
    inset-block-end: 0;
    display: flex;
    gap: 1rem;
  }

  button {
    min-block-size: 2.75rem;
    padding: 0.5rem 1.125rem;
    border: 1px solid var(--fd-color-border-field);
    background: var(--fd-color-surface);
    color: var(--fd-color-text);
    font-size: 0.875rem;
    cursor: pointer;
  }

  .stops button + button {
    margin-inline-start: -1px;
  }

  .stops button[aria-current="true"] {
    border-color: var(--fd-color-text);
    background: var(--fd-color-text);
    color: var(--fd-color-surface);
  }

  .tools button {
    padding-inline: 0.25rem;
    border: 0;
    background: none;
    color: var(--fd-color-text);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .tools button[aria-pressed="true"] {
    font-weight: 700;
    text-decoration-thickness: 2px;
  }

  @media (max-width: 900px) {
    :global(html.stage-on.garden-ready) .garden-nav {
      inset-block-end: 0.75rem;
      flex-direction: column;
      gap: 0.25rem;
    }

    .tools {
      position: static;
    }

    button {
      padding-inline: 0.875rem;
    }
  }
</style>
