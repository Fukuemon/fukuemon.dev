---
// 庭を描く canvas と、庭の中のボタンと、画面の上端と下端の霞を置く。html に class stage-on が付いたときだけ、画面の全体に出す。
// 和紙に置いたセクションは、場面のバンドルがこの中へ移すので、外側の要素は読み上げから隠さない。
import { STATIONS } from "../layout";

// 色は surface、text、border-field、focus で書き、庭の範囲で時間帯の霞の色に差し替える（top-garden の Design Doc の「ヘッダーと霞」）
const mist = "garden-mist from-surface to-transparent";
const stop =
  "min-h-11 min-w-11 cursor-pointer border border-s-0 border-border-field bg-surface px-1 text-label text-text first:border-s focus-visible:focus-ring aria-[current=true]:border-text aria-[current=true]:bg-text aria-[current=true]:text-surface md:px-4";
const tool =
  "min-h-11 cursor-pointer px-1 text-label text-text underline decoration-1 underline-offset-4 focus-visible:focus-ring aria-pressed:decoration-2";
---

<div class="garden-stage bg-surface" data-garden-stage>
  <canvas aria-hidden="true"></canvas>
</div>
<div class:list={[mist, "garden-mist-top bg-linear-to-b from-65%"]} aria-hidden="true"></div>
<div class:list={[mist, "garden-mist-bottom bg-linear-to-t from-65%"]} aria-hidden="true">
</div>
<nav class="garden-nav" data-garden-nav aria-label="庭の中の移動">
  <div class="flex flex-wrap justify-center">
    {
      STATIONS.map(({ label }, i) => (
        <button type="button" class={stop} data-station={i} aria-current={i === 0 ? "true" : "false"}>
          {label}
        </button>
      ))
    }
  </div>
  <div class="flex gap-4">
    <button type="button" class={tool} data-garden-pause aria-pressed="false">動きを止める</button>
    <button type="button" class={tool} data-garden-plain>文だけで読む</button>
  </div>
</nav>
<p class="sr-only" data-garden-live aria-live="polite"></p>

<style>
  .garden-stage,
  .garden-nav,
  .garden-mist {
    display: none;
  }

  :global(html.stage-on) {
    overflow: hidden;
  }

  :global(html.stage-on) .garden-stage {
    position: fixed;
    inset: 0;
    z-index: 20;
    display: block;
  }

  canvas {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  .garden-stage :global(.garden-cards) {
    position: absolute;
    inset: 0;
  }

  /* 見せていない和紙の文は、クリックを受けない。CSS3DRenderer が要素に pointer-events: auto を書くので、!important で止める */
  .garden-stage :global([data-garden-card]:not(.is-current)) {
    pointer-events: none !important;
  }

  /* 霞は、ヘッダーと庭の中の字のボタンの後ろに敷き、字の後ろを霞の色で埋める。面を持たない字は、霞の色で塗りつぶす範囲に収める */
  :global(html.stage-on.garden-ready) .garden-mist {
    position: fixed;
    inset-inline: 0;
    z-index: 25;
    display: block;
    pointer-events: none;
  }

  .garden-mist-top {
    inset-block-start: 0;
    block-size: 6.5rem;
  }

  .garden-mist-bottom {
    inset-block-end: 0;
    block-size: 8.5rem;
  }

  /* ヘッダーは、庭を描く前から文書の流れの外に置き、庭の面の下に隠す。描いた後に外すと、本文が上へずれて CLS に数えられる */
  :global(html.stage-on [data-site-header]) {
    position: fixed;
    inset: 0 0 auto;
  }

  /* 庭を描いた後は、ヘッダーを庭の上に重ね、地を透かして霞の上に置く */
  :global(html.stage-on.garden-ready [data-site-header]) {
    z-index: 30;
    border-color: transparent;
  }

  /* 霞と、霞の上のヘッダーとボタンの色は、和紙と同じく時間帯で決め、テーマに依らない */
  :global(html.stage-on.garden-ready [data-site-header]),
  :global(html.stage-on.garden-ready) .garden-nav,
  :global(html.stage-on.garden-ready) .garden-mist {
    --fd-color-surface: var(--fd-color-garden-mist-day);
    --fd-color-text: var(--fd-color-garden-ink-day);
    --fd-color-border-field: var(--fd-color-garden-edge-day);
    --fd-color-focus: var(--fd-color-garden-ink-day);
  }

  :global(html.stage-on.garden-ready[data-time="night"] [data-site-header]),
  :global(html.stage-on.garden-ready[data-time="night"]) .garden-nav,
  :global(html.stage-on.garden-ready[data-time="night"]) .garden-mist {
    --fd-color-surface: var(--fd-color-garden-mist-night);
    --fd-color-text: var(--fd-color-garden-ink-night);
    --fd-color-border-field: var(--fd-color-garden-edge-night);
    --fd-color-focus: var(--fd-color-garden-ink-night);
  }

  /* 狭い画面では、幅 320px でもヘッダーを霞の色で塗りつぶす範囲の 1 段に収めるよう、間を詰める */
  @media not (min-width: 48rem) {
    :global(html.stage-on.garden-ready [data-site-header] ul),
    :global(html.stage-on.garden-ready [data-site-header] > div) {
      column-gap: 0.5rem;
    }

    :global(html.stage-on.garden-ready [data-site-header] svg) {
      block-size: 2rem;
    }
  }

  /* 狭い画面では、4 つの文へ移るボタンと 2 つの操作を 2 段に分け、広い画面では 1 段に並べる */
  :global(html.stage-on.garden-ready) .garden-nav {
    position: fixed;
    inset: auto 0.5rem 0.5rem;
    z-index: 30;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    pointer-events: none;
  }

  .garden-nav > * {
    pointer-events: auto;
  }

  @media (min-width: 48rem) {
    :global(html.stage-on.garden-ready) .garden-nav {
      inset: auto 1.25rem 1.25rem;
      flex-direction: row;
      justify-content: center;
      gap: 1.5rem;
    }

    .garden-mist-bottom {
      block-size: 6.5rem;
    }
  }
</style>
