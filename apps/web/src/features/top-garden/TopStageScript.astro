---
import { seasonOf, timeOfDayOf } from "./season";
import { applyStage, readOverride } from "./stage";
import { takeFirstVisit } from "./visit";

interface Props {
  /** 場面の束の URL。渡さないときは、庭を出さない */
  bundle?: string;
}
const { bundle } = Astro.props;

// URL の引数を読む処理は、開発のビルドの HTML にだけ入れる
const override = import.meta.env.DEV ? `(${readOverride})(location.search)` : "{}";
const load = bundle
  ? `function(e){var s=document.createElement("script");s.src=${JSON.stringify(bundle)};s.defer=true;s.onerror=e;document.head.appendChild(s)}`
  : "null";
const script =
  `(${applyStage})({root:document.documentElement,now:new Date,override:${override},` +
  `reducedMotion:matchMedia("(prefers-reduced-motion: reduce)").matches,storage:function(){return localStorage},load:${load}},` +
  `{seasonOf:${seasonOf},timeOfDayOf:${timeOfDayOf},takeFirstVisit:${takeFirstVisit}})`;
---

<script is:inline set:html={script} />
