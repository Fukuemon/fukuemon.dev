---
import { stageScript } from "./stage";
// oxlint-disable-next-line import/default -- Vite の ?worker&url は、束の URL の文字列を default で返す。oxlint はこの接尾辞を解決できない
import bundle from "./garden-entry.ts?worker&url";

// 場面の束は、Vite が worker の形で IIFE の 1 ファイルにまとめ、ハッシュを付けて _astro/ に置く。
const script = stageScript({ dev: import.meta.env.DEV, bundle });
---

<script is:inline set:html={script} />
