---
import { inkSvg } from "./ink-svg";
import { signSvg } from "../../../components/sign/sign";
import signSource from "../../../components/sign/sign.svg?raw";

const ink = inkSvg().svg;
const sign = signSvg(signSource);
---

<div class="ink-gate">
  <Fragment set:html={ink} />
  <Fragment set:html={sign} />
</div>

<style>
  /* 描き終えた後の、止まった絵を出す。筆の順に描く動きは、トップのイントロが付ける */
  .ink-gate {
    --art-ink: var(--fd-color-text);
    --art-pine: var(--fd-color-primary);
    position: relative;
    container-type: size;
    block-size: 100dvh;
    inline-size: 100%;
    overflow: hidden;
  }

  .ink-gate :global(.ink-svg) {
    position: absolute;
    inset-inline-start: 50%;
    inset-block-start: 50%;
    translate: -50% -50%;
    aspect-ratio: 16 / 9;
    inline-size: 100cqw;
    overflow: visible;
    pointer-events: none;
  }

  @container (max-aspect-ratio: 16 / 9) {
    .ink-gate :global(.ink-svg) {
      inline-size: 177.78cqh;
    }
  }

  @container (max-aspect-ratio: 1 / 1) {
    .ink-gate :global(.ink-svg) {
      inline-size: 125cqw;
    }
  }

  .ink-gate :global(.ink-svg path) {
    fill: none;
    stroke: var(--art-ink);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ink-gate :global(.ink-svg .far) {
    filter: url(#f-wash);
  }

  .ink-gate :global(.ink-svg .mid),
  .ink-gate :global(.ink-svg .near .lines) {
    filter: url(#f-dry);
  }

  .ink-gate :global(.ink-svg .pine) {
    fill: url(#g-pine);
    opacity: 0.2;
  }

  .ink-gate :global(.sign) {
    position: absolute;
    inset-inline-start: 5cqw;
    inset-block-end: 4cqh;
    inline-size: clamp(11rem, 24cqw, 24rem);
    block-size: auto;
    fill: var(--art-ink);
    rotate: -5deg;
    pointer-events: none;
  }
</style>
