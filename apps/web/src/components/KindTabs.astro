---
import type { ContentType } from "@fukuemon/content-model";
import { ALL_KIND, CONTENT_TYPES, KIND_INDEX, KIND_LABEL } from "../lib/format";

interface Props {
  current: "all" | ContentType;
  counts: Record<"all" | ContentType, number>;
}
const { current, counts } = Astro.props;

// 種別の表示名と URL は format.ts が正本。ここでは並び順だけを決める
const tabs = [
  { key: "all" as const, label: ALL_KIND.label, href: ALL_KIND.href },
  ...CONTENT_TYPES.map((t) => ({ key: t, label: KIND_LABEL[t], href: KIND_INDEX[t] })),
];
---

<nav class="tabs" aria-label="種類で絞り込む">
  {
    tabs.map((t) => (
      <a href={t.href} aria-current={current === t.key ? "page" : undefined}>
        {t.label}
        <span class="n mono">{counts[t.key]}</span>
      </a>
    ))
  }
</nav>
