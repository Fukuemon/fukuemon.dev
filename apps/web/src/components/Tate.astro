---
import { tcy } from "../lib/tate";

interface Props {
  text: string;
  /** 版面の直接の子になる必要があるので、包む要素を足さず tag を選ばせる */
  as?: "span" | "h2" | "p";
  /** 1 字ずつ正立させる。4 字以上の欧文の見出しは回転だと寝たままになる */
  upright?: boolean;
  class?: string;
}
const { text, as: Tag = "span", upright = false, class: extra }: Props = Astro.props;
---

<Tag class:list={["tate", upright && "tate-upright", extra]}>
  {
    tcy(text).map((part) =>
      part.upright ? <span class="tcy">{part.text}</span> : <>{part.text}</>,
    )
  }
</Tag>
