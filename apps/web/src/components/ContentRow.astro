---
import type { ContentRef } from "@fukuemon/content-model";
import { KIND_LABEL, kindClass, ymd } from "../lib/format";

interface Props {
  ref: ContentRef;
  /** 右端に何を出すか。種別か分類か */
  trailing?: "kind" | "tag";
  cap?: boolean;
  /** 刷り上がりの段送り。ビルド時に埋める */
  index?: number;
}
const { ref, trailing = "tag", cap = true, index = 0 } = Astro.props;
---

<a
  class:list={[
    "flex items-center gap-intra-4 min-h-[44px]",
    "rule-row",
    cap && "rule-cap",
  ]}
  href={ref.href}
  style={`--i:${index}`}
>
  <span class="mono meta shrink-0 grow-0 basis-[92px]">{ymd(ref.date)}</span>
  <span class="grow min-w-0 truncate">{ref.title}</span>
  {
    trailing === "kind" ? (
      <span class:list={["meta", kindClass(ref.type)]}>{KIND_LABEL[ref.type]}</span>
    ) : (
      <span class="label">{ref.tags[0]}</span>
    )
  }
</a>
