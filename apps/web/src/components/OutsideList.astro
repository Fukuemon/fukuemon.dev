---
import Tate from "./Tate.astro";
import { OUTSIDE } from "../data/profile";

const ymd = (iso: string) => iso.replaceAll("-", ".");
---

<section class="g-rail outside mx-(--gutter)">
  <Tate as="h2" class="tate-head" text="登壇と寄稿" />
  <div class="flex justify-end items-baseline pb-intra-1">
    <a class="mono meta" href="https://zenn.dev/fukuemon">Zenn の記事すべて →</a>
  </div>
  <ul class="outside__list">
    {
      OUTSIDE.map((o) => (
        <li>
          <a class="hit outside__row" href={o.href}>
            <span class="mono meta outside__date">{ymd(o.date)}</span>
            <span class="outside__title">{o.title}</span>
            <span class="mono meta outside__kind">{o.kind}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
