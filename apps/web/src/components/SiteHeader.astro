---
import { signSvg } from "./sign/sign";
import signSource from "./sign/sign.svg?raw";
import { SITE_NAV, ariaCurrent } from "./site-nav";

const { pathname } = Astro.url;
const sign = signSvg(signSource, "h-10 w-auto fill-current");
---

<header class="border-b-2 border-text px-4 md:px-6" data-site-header>
  <div class="mx-auto flex min-h-16 max-w-page flex-wrap items-center justify-between gap-x-6 gap-y-2 py-2">
    <a
      class="inline-flex min-h-11 items-center text-text focus-visible:focus-ring"
      href="/"
      aria-label="Fukuemon"
      aria-current={ariaCurrent(pathname, "/")}
    >
      <Fragment set:html={sign} />
    </a>
    <nav aria-label="サイトの中の移動">
      <ul class="flex gap-6">
        {
          SITE_NAV.map(({ label, href }) => (
            <li>
              <a
                class="brush-hover brush-current inline-flex min-h-11 min-w-11 items-center justify-center whitespace-nowrap text-text focus-visible:focus-ring"
                href={href}
                aria-current={ariaCurrent(pathname, href)}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
