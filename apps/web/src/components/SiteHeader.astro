---
interface Props {
  current?: "posts" | "playground";
}
const { current } = Astro.props;
const nav = [
  { href: "/blog", label: "Blog", key: "posts" },
  { href: "/playground", label: "Playground", key: "playground" },
] as const;
---

<header class="topbar">
  <a class="hit topbar__logo" href="/">fukuemon.dev</a>
  <nav class="label">
    {nav.map((n) => <a class="hit" href={n.href} aria-current={current === n.key ? "page" : undefined}>{n.label}</a>)}
  </nav>
</header>
