---
import woodland from "@fukuemon/design-system/art/woodland.svg?raw";
import bamboo from "@fukuemon/design-system/art/bamboo_tall.svg?raw";
import grass from "@fukuemon/design-system/art/grass.svg?raw";
import ridge from "@fukuemon/design-system/art/ridge.svg?raw";
import ripple from "@fukuemon/design-system/art/ripple.svg?raw";

const ART = { woodland, bamboo, grass, ridge, ripple } as const;

interface Props {
  motif: keyof typeof ART;
  /** 帯の高さ。fill のときは親いっぱいに広げる */
  height?: string;
  fill?: boolean;
  /** 上端を紙へ溶かす。図の mask は帯が低いと映らず、切り口が区切りに見える */
  fade?: boolean;
}
const { motif, height = "132px", fill = false, fade = false } = Astro.props;

const svg = ART[motif].replace(/\srole="img"\s+aria-label="[^"]*"/, "");
---

<div
  class:list={["wood-band", fill && "wood-band--fill", fade && "wood-band--fade"]}
  aria-hidden="true"
  style={fill ? undefined : `block-size: ${height}`}
>
  <Fragment set:html={svg} />
  <div class="wood-grain"></div>
</div>
