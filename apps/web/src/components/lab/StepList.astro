---
import type { Step } from "@fukuemon/content-model";

interface Props {
  steps: Step[];
  /** 最初の `h2` より前に本文があるとき、「はじめに」の面を出す */
  intro: boolean;
}
const { steps, intro } = Astro.props;
const pad = (n: number) => String(n + 1).padStart(2, "0");
const mins = (s?: number) => (s ? `${Math.round(s / 60)}分` : undefined);

const rows = [
  ...(intro ? [{ index: -1, title: "はじめに", duration: undefined }] : []),
  ...steps,
];
---

{/* 印と進捗は controller.ts が塗る */}
<nav class="steps" aria-label="手順">
  <p class="mono meta steps__count">0 / {steps.length} 歩</p>
  <div class="steps__bar">
    <span
      class="steps__fill"
      role="progressbar"
      aria-valuenow="0"
      aria-valuemin="0"
      aria-valuemax={steps.length}
      aria-label="進捗"></span>
  </div>
  <ol class="steps__list">
    {
      rows.map((s) => (
        <li>
          <a class="steps__link hit" href={`#step-${s.index}`} data-step={s.index}>
            <span aria-hidden="true" class="steps__mark" data-state="todo" />
            <span class="mono meta steps__no">{s.index < 0 ? "—" : pad(s.index)}</span>
            <span class="steps__text">{s.title}</span>
            {mins(s.duration) && <span class="mono meta steps__dur">{mins(s.duration)}</span>}
            <span class="sr steps__state" />
          </a>
        </li>
      ))
    }
  </ol>
</nav>
