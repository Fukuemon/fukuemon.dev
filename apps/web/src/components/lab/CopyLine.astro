---
interface Props {
  text: string;
}
const { text } = Astro.props;
// コメント行は押しても意味がないので、コピーの対象にしない
const isComment = text.trimStart().startsWith("#");
---

<div class="cmd" data-comment={isComment ? "true" : undefined}>
  <code class="mono cmd__text">{text}</code>
  {
    !isComment && (
      <button class="cmd__copy mono meta" type="button" data-copy={text}>
        コピー
      </button>
    )
  }
</div>

<script>
  // 依存を足さない。Clipboard API だけで足りる
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        const before = btn.textContent;
        btn.textContent = "コピーした";
        setTimeout(() => {
          btn.textContent = before;
        }, 1400);
      } catch {
        // 権限が無ければ何もしない。選択してコピーはできる
      }
    });
  }
</script>
