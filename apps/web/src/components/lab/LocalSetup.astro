---
import CopyLine from "./CopyLine.astro";

interface Props {
  repository: string;
  via: "devcontainer" | "docker-compose" | "manual";
  requires: { name: string; check?: string }[];
}
const { repository, via, requires } = Astro.props;

const name = repository.replace(/^https?:\/\/[^/]+\//, "").replace(/\.git$/, "");
const dir = name.split("/").pop() ?? "repo";

/** via ごとの起動コマンド */
const START: Record<Props["via"], { label: string; lines: string[] }> = {
  devcontainer: {
    label: "Dev Container で開く",
    lines: ["code .", "# コマンドパレット → Dev Containers: Reopen in Container"],
  },
  "docker-compose": { label: "起動する", lines: ["docker compose up -d"] },
  manual: { label: "用意する", lines: ["# README の手順に従ってください"] },
};
const start = START[via];
---

<section class="my-inter-1 pt-intra-3" aria-labelledby="local-setup">
  <h2 class="mono meta mb-intra-2" id="local-setup">手元で用意する</h2>

  <p class="prose mt-0 mb-intra-3 text-fg-2">
    このハンズオンはブラウザの中では動きません。リポジトリを自分の環境へ持っていって進めます。
  </p>

  {
    requires.length > 0 && (
      <div class="mb-intra-3">
        <p class="mono meta mb-intra-1">要るもの</p>
        <ul class="list-none m-0 p-0">
          {requires.map((r) => (
            <li class="mb-intra-1">
              <span class="block text-[0.9rem]">{r.name}</span>
              {r.check && <CopyLine text={r.check} />}
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <div class="mb-intra-3">
    <p class="mono meta mb-intra-1">取ってくる</p>
    <CopyLine text={`git clone ${repository}`} />
    <CopyLine text={`cd ${dir}`} />
  </div>

  <div class="mb-intra-3">
    <p class="mono meta mb-intra-1">{start.label}</p>
    {start.lines.map((l) => <CopyLine text={l} />)}
  </div>

  <p class="mono meta">
    <a class="text-link" href={repository}>{name} ↗</a>
  </p>
</section>
