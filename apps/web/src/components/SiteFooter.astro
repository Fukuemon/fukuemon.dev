---
import Icon from "./Icon.astro";
import { LINKS } from "../data/profile";
---

<footer data-band class="foot">
  <span class="mono meta">© 2026 fukuemon · CC BY 4.0</span>
  {/* URL の正本は data/profile.ts。ここでは持たない */}
  <span class="foot__links">
    {
      LINKS.map((l) => (
        <a class="hit" href={l.href} aria-label={l.label} title={l.label}>
          <Icon name={l.icon} size={16} />
        </a>
      ))
    }
  </span>
</footer>
