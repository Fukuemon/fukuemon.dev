---
import Icon from "./Icon.astro";
import { LINKS } from "../data/profile";

interface Props {
  class?: string;
}
const { class: extra } = Astro.props as Props;
---

{/* 印だけを並べる。語より形のほうが速く見分けられる。名前は aria-label が持つ */}
<p class:list={["links", extra]}>
  {
    LINKS.map((l) => (
      <a class="hit links__item" href={l.href} aria-label={l.label} title={l.label}>
        <Icon name={l.icon} />
      </a>
    ))
  }
</p>
