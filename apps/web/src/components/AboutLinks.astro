---
import Icon from "./Icon.astro";
import { LINKS } from "../data/profile";

interface Props {
  class?: string;
}
const { class: extra } = Astro.props as Props;
---

{/* 字ではないので溝は詰める。当たり判定は 44px を保つ (.hit + w-11) */}
<p class:list={["flex flex-wrap gap-intra-1 m-0", extra]}>
  {
    LINKS.map((l) => (
      <a
        class="hit justify-center w-11 text-fg-2 transition-[color] duration-[140ms] ease-out hover:text-link"
        href={l.href}
        aria-label={l.label}
        title={l.label}
      >
        <Icon name={l.icon} />
      </a>
    ))
  }
</p>
