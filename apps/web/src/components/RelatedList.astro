---
import type { ContentRef } from "@fukuemon/content-model";
import ContentRow from "./ContentRow.astro";

interface Props {
  items: ContentRef[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="rule-struct mt-inter-3 pt-intra-3 pb-inter-2">
      <h2 class="mono meta mb-intra-2">関連</h2>
      {items.map((r) => (
        <ContentRow ref={r} trailing="kind" />
      ))}
    </section>
  )
}
