---
import Tate from "./Tate.astro";
import type { ContentRef } from "@fukuemon/content-model";
import { KIND_INDEX, kindLine } from "../lib/format";

interface Props {
  heading: string;
  items: ContentRef[];
  lead: string;
}
const { heading, items, lead } = Astro.props as Props;
const shown = items.slice(0, 3);
const href = KIND_INDEX[items[0]?.type ?? "article"];
---

{/* 種別の抽象的な札ではなく、実物を 3 本並べる。何が読めるかがその場で分かる */}
<section class="g-rail mt-inter-3 mx-(--gutter)">
  <Tate as="h2" class="tate-head" text={heading} />
  <div class="flex justify-end items-baseline pb-intra-1">
    <a class="mono meta" href={href}>{items.length} 本すべて →</a>
  </div>
  <div>
    <p class="prose mt-intra-2 mb-0 max-w-(--measure-w) text-fg-2">{lead}</p>
    <div class="mt-inter-1 grid grid-cols-[repeat(auto-fit,minmax(min(18rem,100%),22rem))] max-narrow:grid-cols-[minmax(0,1fr)]">
      {
        shown.map((r) => (
          <a class="flex flex-col px-intra-4 first:ps-0 max-narrow:px-0 text-fg border-rule not-first:border-s max-narrow:not-first:border-s-0 max-narrow:not-first:border-t max-narrow:not-first:pt-intra-3 max-narrow:not-first:mt-intra-3" href={r.href}>
            <span aria-hidden="true" class="w-[26px] h-[2px] bg-now" />
            <h3 class="mt-intra-2 text-[1.05rem]">{r.title}</h3>
            <p class="prose mt-intra-1 mb-intra-3 text-[0.9rem] text-fg-2 grow">{r.description}</p>
            <span class="mono meta text-fg-2">{kindLine(r, false)}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
